generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Gasto {
  id          Int      @id @default(autoincrement())
  monto       Float
  categoria   String
  fecha       String
  nota        String   @default("")
  comprobante String   @default("")
  tipo        String
  createdAt   DateTime @default(now())
}
