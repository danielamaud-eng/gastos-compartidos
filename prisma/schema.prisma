generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Gasto {
  id          Int      @id @default(autoincrement())
  monto       Float
  categoria   String
  fecha       String
  nota        String   @default("")
  comprobante String   @default("")
  tipo        String
  pagadoPor   String   @default("")
  createdAt   DateTime @default(now())
}

model Pago {
  id        Int      @id @default(autoincrement())
  monto     Float
  fecha     String
  de        String
  para      String
  nota      String   @default("")
  createdAt DateTime @default(now())
}
